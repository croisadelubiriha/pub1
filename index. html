class SiteHandler(BaseHTTPRequestHandler):

    def envoyer(self, texte):

        self.send_response(200)

        self.send_header(
            "Content-Type",
            "text/html; charset=utf-8"
        )

        self.end_headers()

        self.wfile.write(
            texte.encode("utf-8")
        )


    def formulaire(self):

        longueur = int(
            self.headers.get(
                "Content-Length",
                0
            )
        )

        contenu = self.rfile.read(
            longueur
        ).decode("utf-8")

        return urllib.parse.parse_qs(
            contenu
        )


